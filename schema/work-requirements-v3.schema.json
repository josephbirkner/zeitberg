{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Zeitberg employer work requirements v3",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "generated_at",
        "employers"
    ],
    "properties": {
        "schema_version": {
            "const": 3
        },
        "generated_at": {
            "type": "string"
        },
        "employers": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/employer"
            }
        }
    },
    "$defs": {
        "schedule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "effective_from",
                "hours"
            ],
            "properties": {
                "effective_from": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(19|20|21)\\d{2}-\\d{2}-\\d{2}$"
                },
                "hours": {
                    "type": "array",
                    "minItems": 7,
                    "maxItems": 7,
                    "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 24
                    }
                }
            }
        },
        "day": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "date",
                "halves",
                "comment"
            ],
            "properties": {
                "date": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(19|20|21)\\d{2}-\\d{2}-\\d{2}$"
                },
                "halves": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                        "enum": [
                            "work",
                            "pto",
                            "sick",
                            "holiday",
                            "flex"
                        ]
                    }
                },
                "comment": {
                    "type": "string"
                }
            }
        },
        "adjustment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "date",
                "days",
                "comment"
            ],
            "properties": {
                "date": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(19|20|21)\\d{2}-\\d{2}-\\d{2}$"
                },
                "days": {
                    "type": "number"
                },
                "comment": {
                    "type": "string"
                }
            }
        },
        "employer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name",
                "project_keys",
                "active_from",
                "active_until",
                "tracking_start",
                "opening_overtime_hours",
                "opening_vacation_days",
                "schedules",
                "vacation_allowances",
                "vacation_adjustments",
                "days"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "project_keys": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "active_from": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(19|20|21)\\d{2}-\\d{2}-\\d{2}$"
                },
                "active_until": {
                    "anyOf": [
                        {
                            "type": "string",
                            "format": "date",
                            "pattern": "^(19|20|21)\\d{2}-\\d{2}-\\d{2}$"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "tracking_start": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(19|20|21)\\d{2}-\\d{2}-\\d{2}$"
                },
                "opening_overtime_hours": {
                    "type": "number"
                },
                "opening_vacation_days": {
                    "type": "number"
                },
                "schedules": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/schedule"
                    }
                },
                "vacation_allowances": {
                    "type": "object",
                    "propertyNames": {
                        "pattern": "^(19|20|21)\\d{2}$"
                    },
                    "additionalProperties": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 366
                    }
                },
                "vacation_adjustments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/adjustment"
                    }
                },
                "days": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/day"
                    }
                }
            }
        }
    }
}

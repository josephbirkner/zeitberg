{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeitplural.io/schema/expenses-manifest-v1.schema.json",
  "title": "Zeitplural Expense Manifest (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "categories",
    "currencies",
    "date_from",
    "date_to",
    "expenses",
    "generated_at",
    "participants",
    "path",
    "schema_version",
    "sha",
    "size",
    "transfers"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string" },
    "path": {
      "type": "string",
      "pattern": "^[^/\\\\?#]+(?:/[^/\\\\?#]+)*$",
      "not": { "pattern": "(^|/)\\.{1,2}(/|$)" }
    },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "size": { "type": "integer", "minimum": 0 },
    "participants": { "type": "integer", "minimum": 0 },
    "categories": { "type": "integer", "minimum": 0 },
    "expenses": { "type": "integer", "minimum": 0 },
    "transfers": { "type": "integer", "minimum": 0 },
    "currencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{3}$" }
    },
    "date_from": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "date_to": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
